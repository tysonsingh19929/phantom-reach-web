{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/business-login", "destination": "/auth.html?role=business" },
    { "source": "/creator-login", "destination": "/auth.html?role=creator" },
    { "source": "/signup", "destination": "/signup.html" },
    { "source": "/signup-business", "destination": "/signup-role.html?role=business" },
    { "source": "/signup-creator", "destination": "/signup-role.html?role=creator" },
    { "source": "/tools/:tool", "destination": "/tool.html?tool=:tool" }
  ]
}
