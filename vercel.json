{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/x-icon"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=2592000, immutable"
        }
      ]
    },
    {
      "source": "/favicon-48x48.png",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=2592000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon-.*\\.png|apple-touch-icon.*\\.png|favicon\\.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=2592000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/backend-url",
      "destination": "/api/backend-url"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?path=:path*"
    },
    {
      "source": "/api/admin/audit-logs",
      "destination": "/api/admin-users?action=logs"
    },
    {
      "source": "/api/admin/users/:id/status",
      "destination": "/api/admin-users?id=:id&action=status"
    },
    {
      "source": "/api/admin/users/:id",
      "destination": "/api/admin-users?id=:id"
    },
    {
      "source": "/api/admin/users",
      "destination": "/api/admin-users"
    },
    {
      "source": "/api/run",
      "destination": "/api/run"
    },
    {
      "source": "/api/tasks/:id",
      "destination": "/api/task?id=:id"
    },
    {
      "source": "/api/campaigns/:path*",
      "destination": "/api/campaigns?path=:path*"
    },
    {
      "source": "/api/campaigns",
      "destination": "/api/campaigns.js"
    },
    {
      "source": "/api/track",
      "destination": "/api/track.js"
    },
    {
      "source": "/api/creators",
      "destination": "/api/creators.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?path=:path*"
    },
    {
      "source": "/tools/influencer-score/:slug",
      "destination": "/tools/influencer-score/:slug/index.html"
    },
    {
      "source": "/tools/google-leads/:slug",
      "destination": "/tools/google-leads/:slug/index.html"
    },
    {
      "source": "/tools/instagram-leads/:slug",
      "destination": "/tools/instagram-leads/:slug/index.html"
    },
    {
      "source": "/tools/youtube/:slug",
      "destination": "/tools/youtube/:slug/index.html"
    },
    {
      "source": "/tools/engagement-rate-calculator",
      "destination": "/tools/engagement-rate-calculator/index.html"
    },
    {
      "source": "/tools/instagram-leads",
      "destination": "/tools/instagram-leads/index.html"
    },
    {
      "source": "/tools/google-leads",
      "destination": "/tools/google-leads/index.html"
    },
    {
      "source": "/tools/influencer-score",
      "destination": "/tools/influencer-score/index.html"
    },
    {
      "source": "/tools/youtube",
      "destination": "/tools/youtube/index.html"
    },
    {
      "source": "/tools/linkedin",
      "destination": "/tools/linkedin/index.html"
    },
    {
      "source": "/tools/x-twitter",
      "destination": "/tools/x-twitter/index.html"
    },
    {
      "source": "/tools/automate-ai",
      "destination": "/tools/automate-ai/index.html"
    },
    {
      "source": "/tools",
      "destination": "/tools/index.html"
    },
    {
      "source": "/tools/:tool*",
      "destination": "/tool.html"
    },
    {
      "source": "/business-login",
      "destination": "/auth.html"
    },
    {
      "source": "/creator-login",
      "destination": "/auth.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/signup-business",
      "destination": "/signup-role.html"
    },
    {
      "source": "/signup-creator",
      "destination": "/signup-role.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/exchange",
      "destination": "/exchange/index.html"
    },
    {
      "source": "/collabs",
      "destination": "/collabs/index.html"
    }
  ]
}
