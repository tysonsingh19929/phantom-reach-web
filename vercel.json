{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/backend-url",
      "destination": "/api/backend-url"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?path=:path*"
    },
    {
      "source": "/api/admin/audit-logs",
      "destination": "/api/admin-users?action=logs"
    },
    {
      "source": "/api/admin/users/:id/status",
      "destination": "/api/admin-users?id=:id&action=status"
    },
    {
      "source": "/api/admin/users/:id",
      "destination": "/api/admin-users?id=:id"
    },
    {
      "source": "/api/admin/users",
      "destination": "/api/admin-users"
    },
    {
      "source": "/api/run",
      "destination": "/api/run"
    },
    {
      "source": "/api/tasks/:id",
      "destination": "/api/task?id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?path=:path*"
    },
    {
      "source": "/tools/:tool*",
      "destination": "/tool.html"
    },
    {
      "source": "/tools",
      "destination": "/tool.html"
    },
    {
      "source": "/business-login",
      "destination": "/auth.html"
    },
    {
      "source": "/creator-login",
      "destination": "/auth.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/signup-business",
      "destination": "/signup-role.html"
    },
    {
      "source": "/signup-creator",
      "destination": "/signup-role.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
